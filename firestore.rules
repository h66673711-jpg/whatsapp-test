rules_version = 2;
service cloud.firestore {
  match /databases/{db}/documents {
    function signed() { return request.auth != null && request.auth.token.email_verified == true; }
    function isAdmin() { return request.auth != null && request.auth.token.admin == true; }
    function active() { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data.status == active; }
    function chatData(chatId) { return get(/databases/$(db)/documents/chats/$(chatId)).data; }
    function isMember(chatId) { return request.auth.uid in chatData(chatId).members; }
    function otherOf(chatId) {
      return chatData(chatId).members[0] == request.auth.uid ? chatData(chatId).members[1] : chatData(chatId).members[0];
    }
    function notBlocked(chatId) {
      return chatData(chatId).type == group
        || !exists(/databases/$(db)/documents/users/$(otherOf(chatId))/blocked/$(request.auth.uid));
    }

    match /users/{uid} {
      allow read: if signed();
      allow create: if signed() && request.auth.uid == uid && request.resource.data.status == active;
      allow update: if signed() && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([status]);
      allow update: if isAdmin();
    }
    // unique usernames: document id = lowercase username
    match /usernames/{name} {
      allow read: if signed();
      allow create: if signed() && request.resource.data.uid == request.auth.uid;
      allow delete: if signed() && resource.data.uid == request.auth.uid;
    }
    match /users/{uid}/blocked/{target} {
      allow read, write: if signed() && request.auth.uid == uid;
    }
    match /chats/{chatId} {
      allow read: if signed() && request.auth.uid in resource.data.members;
      allow create: if signed() && active() && request.auth.uid in request.resource.data.members
        && ((request.resource.data.type == direct && request.resource.data.members.size() == 2)
         || (request.resource.data.type == group && request.resource.data.members.size() >= 2
             && request.resource.data.members.size() <= 256
             && request.resource.data.admins == [request.auth.uid]));
      // members/admins may only change in a group, and only by a group admin
      allow update: if signed() && request.auth.uid in resource.data.members
        && request.resource.data.type == resource.data.type
        && (request.resource.data.members == resource.data.members
            || (resource.data.type == group && request.auth.uid in resource.data.get(admins, [])))
        && (request.resource.data.get(admins, []) == resource.data.get(admins, [])
            || request.auth.uid in resource.data.get(admins, []));

      match /messages/{msgId} {
        allow read: if signed() && isMember(chatId);
        allow create: if signed() && active() && isMember(chatId) && notBlocked(chatId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.createdAt == request.time
          && (!(text in request.resource.data) || request.resource.data.text.size() <= 4000);
        allow update: if signed() && isMember(chatId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([deliveredTo, readBy]);
        allow delete: if false;
      }
    }
    match /reports/{id} {
      allow create: if signed() && request.resource.data.reporterId == request.auth.uid;
      allow read, update: if isAdmin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
